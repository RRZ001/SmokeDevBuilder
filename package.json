{
  "name": "agentcloud",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud AI Coding Agent - Next.js + Tailwind + Supabase + E2B Sandbox + OpenRouter",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "build:root": "NEXT_PUBLIC_BASE_PATH= next build",
    "test:files": "npx --yes tsx@4 tests/project-files.mts",
    "test:files-fallback": "npx --yes tsx@4 tests/files-missing-table.mts",
    "test:preview": "npx --yes tsx@4 tests/preview-recovery.mts"
  },
  "dependencies": {
    "@e2b/code-interpreter": "2.8.0",
    "@supabase/supabase-js": "2.117.2",
    "better-sqlite3": "12.9.0",
    "highlight.js": "11.12.0",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3"
  }
}
