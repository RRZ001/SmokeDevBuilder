# ---------------------------------------------------------------------------
# AgentCloud - contoh environment variable
# Salin file ini menjadi .env.local (untuk lokal) atau isikan langsung di
# panel environment platform hosting saat deploy.
#
# Catatan: OPENROUTER_API_KEY dan E2B_API_KEY boleh dikosongkan di sini --
# keduanya juga bisa diisi dari UI aplikasi (tombol Settings) dan disimpan
# ke database. Nilai dari environment selalu diprioritaskan.
# ---------------------------------------------------------------------------

# 1) OpenRouter (wajib untuk fungsi AI Agent) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opsional: override endpoint OpenRouter (mis. gateway/proxy sendiri)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Opsional: dipakai OpenRouter untuk atribusi aplikasi kamu
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AgentCloud

# 2) E2B Cloud Sandbox (wajib untuk eksekusi perintah/file) -> https://e2b.dev/dashboard
E2B_API_KEY=

# Lama hidup sandbox (ms). Naikkan bila plan E2B kamu mengizinkan.
E2B_SANDBOX_TIMEOUT_MS=600000

# 3) Supabase (opsional). Bila kosong, aplikasi otomatis memakai SQLite lokal.
#    SUPABASE_URL = Project URL saja: https://<project-ref>.supabase.co
#    (tanpa /rest/v1, tanpa kutip, tanpa spasi - kode menormalkan, tapi lebih baik benar)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Boleh pakai anon key jika tidak ingin memakai service role (lihat README bagian Supabase)
SUPABASE_ANON_KEY=

# 4) Opsional - kendali biaya token (lihat README bagian "Menghemat biaya")
#    Selama ini nilai default sudah dioptimalkan; ubah hanya bila perlu.
# AGENT_MAX_OUTPUT_TOKENS=8192        # batas token keluaran per langkah
# AGENT_HISTORY_TOOL_DETAILS=4        # hanya N pemanggilan tool terakhir yang isinya dikirim utuh
# AGENT_HISTORY_CHAR_BUDGET=60000     # batas keras ukuran prompt (karakter)
# AGENT_HISTORY_MESSAGES=24           # batas jumlah pesan dalam riwayat
# AGENT_TOOL_OUTPUT_CHARS=4000        # batas hasil tool yang dikirim ke model
# AGENT_MAX_STEPS=12                  # batas langkah tool per giliran
# AGENT_MAX_AUTO_DEBUG=2              # batas ronde auto-debug

# 5) Opsional - override lokasi database SQLite fallback
# AGENTCLOUD_DB_PATH=/absolute/path/agentcloud.sqlite

# 6) Opsional - base path saat dipublish di subpath (mis. /agentcloud).
#     Di Vercel JANGAN diisi: aplikasi dilayani di root, dan nilai yang
#     tertinggal di sini membuat semua fetch API 404.
# NEXT_PUBLIC_BASE_PATH=
